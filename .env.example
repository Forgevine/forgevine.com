# Google Analytics Measurement ID
# Get your GA4 Measurement ID from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Resend (contact form delivery)
# Get an API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Verified sender and inbox for contact form submissions
RESEND_FROM_EMAIL="Forgevine Contact <hello@your-verified-domain.com>"
RESEND_TO_EMAIL=contact@forgevine.com
